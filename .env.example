# Copy to .env.local (local) and to Vercel → Project → Settings → Environment Variables (prod).
# NEVER commit real values. .env* is gitignored except this file.

# ── Required for chat ───────────────────────────────────────────
GROQ_API_KEY=            # console.groq.com – chat LLM (llama-3.3-70b-versatile)
COHERE_API_KEY=          # dashboard.cohere.com – query embeddings + rerank (CO_API_KEY is accepted as an alias)

# ── Required for booking (Google Calendar, OAuth2 refresh-token flow) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # mint with: npm run google-auth

# ── Required for the voice agent webhook ────────────────────────
VAPI_WEBHOOK_SECRET=     # long random string; set the SAME value as the server secret/bearer in the Vapi dashboard.
                         # While unset the webhook accepts unauthenticated calls (a warning is logged).

# ── Optional ────────────────────────────────────────────────────
PINECONE_API_KEY=        # enables Pinecone retrieval (index "vinay-persona"); unset = in-memory search over data/index.json
GITHUB_TOKEN=            # only for `npm run rebuild-index` (raises GitHub API rate limit)
ALLOWED_ORIGINS=         # comma-separated extra origins allowed to call the API from a browser (default: none, same-origin only)

# Persona / calendar
OWNER_CALENDAR_EMAIL=    # attendee added to every booking (default set in lib/config.ts)

# Tuning (all optional – defaults in lib/limits.ts and lib/retriever.ts)
# RATE_CHAT_PER_MIN=20  RATE_CHAT_PER_DAY=300  RATE_WEBHOOK_PER_MIN=120  MAX_BOOKINGS_PER_HOUR=12
# MAX_USER_CHARS=1000   HISTORY_FOR_LLM=16     MAX_BODY_BYTES=262144
# RAG_MIN_SCORE=0.25    INDEX_INCLUDE_FORKS=grass,guppy
