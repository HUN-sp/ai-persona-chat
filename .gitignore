# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – never commit; copy .env.example to .env.local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts/ IS tracked (rebuild-index, seed-pinecone, google-auth read secrets from env only).
# Keep throw-away scripts that embed credentials in scripts/local/ – never committed.
/scripts/local/
/scripts/*.local.*

# pre-built RAG index is committed to git (see data/index.json)

# per-developer Claude Code settings
/.claude/settings.local.json

# eval artefacts
/evals/results/
